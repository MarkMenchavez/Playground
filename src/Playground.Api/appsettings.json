{
  "FeatureManagement": {
    "IncludeExceptionDetailsInProblemDetails": false,
    "EchoApi": true
  },  
  "WeatherForecastService": {
    "DefaultDays": 50,
    "Summaries": [
      "Freezing",
      "Bracing",
      "Chilly",
      "Cool",
      "Mild",
      "Warm",
      "Balmy",
      "Hot",
      "Sweltering",
      "Scorching"
    ],
    "GenerationDelayMilliseconds": 10
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Async", "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Polly": "Error",
        "Rebus.ServiceProvider.Internals": "Warning",
        "Rebus.Threading": "Warning",
        "Rebus.Pipeline.Send": "Warning",
        "Microsoft.Extensions.Hosting.Internal": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Warning",
        "Microsoft.AspNetCore.Watch.BrowserRefresh": "Warning",
        "Microsoft.AspNetCore.HostFiltering": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Http": "Warning",
        "Microsoft.AspNetCore.Mvc.Infrastructure": "Warning",
        "Microsoft.AspNetCore.Mvc.ApiExplorer": "Warning",
        "Microsoft.Extensions.ServiceDiscovery": "Warning",
        "Microsoft.AspNetCore.HttpsPolicy": "Warning",
        "Microsoft.Extensions.Http": "Information",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "HttpLogging": {
    "LoggingFields": "None"
  },
  "HeaderPropagation": {
    "Headers": [ "X-Correlation-ID" ]
  },
  "Kestrel": {
    "AddServerHeader": false,
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 50,
      "MaxRequestBufferSize": 32768,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestLineSize": 8192,
      "MaxRequestHeaderCount": 100,
      "KeepAliveTimeout": "00:00:15",
      "RequestHeadersTimeout": "00:00:10"
    }
  }  
}